{
  "name": "zoggyfin",
  "version": "0.1.0",
  "description": "A fast, clear Jellyfin client for iPhone, iPad, Mac and the web",
  "homepage": "https://zoggyfin.zog-tech.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zog-tech/zoggyfin.git"
  },
  "bugs": {
    "url": "https://github.com/zog-tech/zoggyfin/issues"
  },
  "author": "Zog Tech, Inc. <admin@zog-tech.com>",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/noto-sans-arabic": "^0.4.3",
    "@expo/dom-webview": "58.0.2",
    "@expo/vector-icons": "^15.1.1",
    "@jellyfin/sdk": "^1.0.2",
    "@kesha-antonov/react-native-background-downloader": "4.6.3",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-tvos/config-tv": "0.1.7",
    "@shopify/flash-list": "2.3.3",
    "@tanstack/query-sync-storage-persister": "^5.107.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-persist-client": "^5.107.1",
    "axios": "^1.21.0",
    "expo": "~58.0.23",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.20",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "expo-video": "~58.0.13",
    "fflate": "0.8.3",
    "hls.js": "1.7.4",
    "lucide-react": "0.544.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "npm:react-native-tvos@0.88.0-0",
    "react-native-gesture-handler": "~3.5.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-pager-view": "9.0.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.1",
    "zod": "4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.14",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "desktop:dev": "tauri dev --config desktop/src-tauri/tauri.conf.json",
    "desktop:build": "expo export --platform web && tauri build --bundles app --config desktop/src-tauri/tauri.conf.json",
    "desktop:release": "bash desktop/scripts/release.sh",
    "desktop:publish": "bash desktop/scripts/publish.sh",
    "desktop:version": "bash desktop/scripts/version.sh",
    "site:deploy": "bash site/scripts/deploy.sh",
    "tv:release": "bash scripts/release-android-tv.sh",
    "test:crypto-swift": "bash scripts/rendezvous-vectors/run.sh",
    "test:ts-bridge-swift": "bash scripts/ts-bridge/run.sh",
    "bench:together": "bash scripts/together-bench/run.sh",
    "stress:controls": "pnpm dlx tsx@4.20.5 --tsconfig scripts/together-bench/tsconfig.json scripts/together-bench/controls-stress.ts"
  },
  "private": true,
  "license": "MPL-2.0",
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "expo-video"
        ]
      }
    }
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^.*/rendezvous-cipher$": "<rootDir>/src/together/rendezvous-cipher.ts",
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@jellyfin|@noble|lucide-react))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/ios/",
      "/android/",
      "<rootDir>/.claude/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/"
    ]
  }
}
