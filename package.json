    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.11",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "desktop:dev": "tauri dev --config desktop/src-tauri/tauri.conf.json",
    "desktop:build": "expo export --platform web && tauri build --bundles app --config desktop/src-tauri/tauri.conf.json",
    "desktop:release": "bash desktop/scripts/release.sh",
    "desktop:publish": "bash desktop/scripts/publish.sh",
    "desktop:version": "bash desktop/scripts/version.sh",
    "site:deploy": "bash site/scripts/deploy.sh",
    "test:crypto-swift": "bash scripts/rendezvous-vectors/run.sh",
    "bench:together": "bash scripts/together-bench/run.sh"
  },
  "private": true,
  "license": "MPL-2.0",
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^.*/rendezvous-cipher$": "<rootDir>/src/together/rendezvous-cipher.ts",
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@jellyfin))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/ios/",
      "/android/"
    ]
  }
}
